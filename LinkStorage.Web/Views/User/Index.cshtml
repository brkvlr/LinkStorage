@model IEnumerable<LinkStorage.Models.AppUser>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <h1 class="mt-4">Kullanıcı Yönetimi</h1>
    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-user me-1"></i>
                    Kullanıcılar
                </div>
                <div class="card-body">

                    <button type="button" class="btn btn-primary waves-effect waves-light mb-3" data-bs-toggle="modal" data-bs-target="#addUserModal">
                        <i class="bx bx-plus font-size-16 align-middle me-2"></i> Yeni Kullanıcı Ekle
                    </button>

                    <table id="userTable" class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Kullanıcı Adı</th>
                                <th>Email</th>
                                <th>Kullanıcı Tipi</th>
                                <th>Eylemler</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add User Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1" role="dialog" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addUserModalLabel">Yeni Kullanıcı Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <form id="addUserForm">
                    <div class="mb-3">
                        <label for="userName" class="form-label">Kullanıcı Adı</label>
                        <input type="text" class="form-control" id="username" name="UserName" required>
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" name="Email" required>
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">Şifre</label>
                        <input type="password" class="form-control" id="password" name="Password" required>
                    </div>
                    <div class="mb-3">
                        <label for="userTypeId" class="form-label">Kullanıcı Tipi</label>
                        <select class="form-select" id="userTypeId" name="UserTypeId" required>
                            <option value="" disabled selected>Kullanıcı Tipini Seçin</option>
                            <option value="1">Admin</option>
                            <option value="2">Kullanıcı</option>
                        </select>
                       
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" id="saveNewUser">Kullanıcıyı Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1" role="dialog" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editUserModalLabel">Kullanıcıyı Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <form id="editUserForm">
                    <input type="hidden" id="editUserId" name="Id">
                    <div class="mb-3">
                        <label for="editUserName" class="form-label">Kullanıcı Adı</label>
                        <input type="text" class="form-control" id="editUserName" name="UserName" required>
                    </div>
                    <div class="mb-3">
                        <label for="editEmail" class="form-label">Email</label>
                        <input type="email" class="form-control" id="editEmail" name="Email" required>
                    </div>
                    <div class="mb-3">
                        <label for="editPassword" class="form-label">Şifre</label>
                        <input type="password" class="form-control" id="editPassword" name="Password">
                        <small class="form-text text-muted">Yeni şifre girmediyseniz mevcut şifre korunacaktır.</small>
                    </div>
                    <div class="mb-3">
                        <label for="editUserTypeId" class="form-label">Kullanıcı Tipi</label>
                        <select class="form-select" id="editUserTypeId" name="UserTypeId" required>
                            <option value="" disabled selected>Kullanıcı Tipini Seçin</option>
                            <option value="1">Admin</option>
                            <option value="2">Kullanıcı</option>
                        </select>
                        <input type="hidden" name="UserTypeId" value="2" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" id="saveEditUser">Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.10.24/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.24/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            var table = $('#userTable').DataTable({
                "ajax": {
                    "url": "@Url.Action("GetAll", "User")",
                    "type": "GET",
                    "dataSrc": "data"
                },
                "columns": [
                    { "data": "id", "name": "userId" },
                    { "data": "userName", "name": "userName" },
                    { "data": "email", "name": "email" },
                    { "data": "userTypeName", "name": "UserTypeName" },
                    {
                        "data": "id",
                        "render": function (data) {
                            return `<div class="btn-group" role="group">
                                        <button class="btn btn-primary btn-sm edit-user" data-id="${data}">Düzenle</button>
                                        <button class="btn btn-danger btn-sm" onclick="deleteUser(${data})">Sil</button>
                                    </div>`;
                        },
                        "orderable": false
                    }
                ],
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Turkish.json"
                }
            });

            // Yeni Kullanıcı Ekleme
            $('#saveNewUser').click(function () {
                var formData = $('#addUserForm').serialize();

                $.ajax({
                    url: '@Url.Action("Add", "User")',
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        if (response.success) {
                            $('#addUserModal').modal('hide');
                            table.ajax.reload();
                            Swal.fire('Başarılı', 'Kullanıcı başarıyla eklendi.', 'success');
                        } else {
                            Swal.fire('Hata', 'Kullanıcı eklenirken bir hata oluştu.', 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Hata', 'Kullanıcı kaydedilirken bir hata oluştu.', 'error');
                    }
                });
            });

            // Kullanıcıyı Düzenle
            $('#userTable').on('click', '.edit-user', function () {
                var userId = $(this).data('id');
                $.ajax({
                    url: '@Url.Action("GetById", "User")',
                    type: 'POST',
                    data: { id: userId },
                    success: function (user) {
                        $('#editUserId').val(user.id);
                        $('#editUserName').val(user.userName);
                        $('#editEmail').val(user.email);
                        $('#editPassword').val(user.password);
                        $('#editUserTypeId').val(user.userTypeId);
                        $('#editUserModal').modal('show');
                    }
                });
            });

            // Düzenlenen Kullanıcıyı Kaydet
            $('#saveEditUser').click(function () {
                var formData = $('#editUserForm').serialize();

                $.ajax({
                    url: '@Url.Action("Update", "User")',
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        if (response.success) {
                            $('#editUserModal').modal('hide');
                            table.ajax.reload();
                            Swal.fire('Başarılı', 'Kullanıcı başarıyla güncellendi.', 'success');
                        } else {
                            Swal.fire('Başarılı', 'Kullanıcı başarıyla güncellendi.', 'success');
                        }
                    },
                    error: function () {
                        Swal.fire('Hata', 'Kullanıcı güncellenirken bir hata oluştu.', 'error');
                    }
                });
            });
        });

        // Kullanıcıyı Sil
        function deleteUser(userId) {
            Swal.fire({
                title: 'Emin misiniz?',
                text: "Bu kullanıcıyı silmek istediğinize emin misiniz?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Evet, sil!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete", "User")',
                        type: 'POST',
                        data: { id: userId },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire('Silindi!', 'Kullanıcı başarıyla silindi.', 'success');
                                $('#userTable').DataTable().ajax.reload();
                            } else {
                                Swal.fire('Silindi!', 'Kullanıcı başarıyla silindi.', 'success');
                            }
                        }
                    });
                }
            });
        }
    </script>
}
