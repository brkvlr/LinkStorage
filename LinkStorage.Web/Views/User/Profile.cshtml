@model AppUser
<div>
    <div class="card">
        <div class="card-body">
            <div class="text">
                <p class="mb-1">Mail:</p>
                <h5 class="mt-3 mb-1">@Model.Email</h5>
            </div>

            <hr class="my-4">

            <div class="text-muted">
                <div class="table-responsive mt-4">
                    <div>
                        <p class="mb-1">Şifre:</p>
                        <h5 class="font-size-16">
                            <span id="passwordDisplay">*</span>
                            <button type="button" class="btn btn-link" id="togglePassword" style="cursor: pointer;">
                                <i class="fas fa-eye" id="eyeIcon"></i>
                            </button>
                        </h5>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Profil Düzenleme Modal -->
    <div class="modal fade" id="profileEditModal" tabindex="-1" aria-labelledby="profileEditModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary bg-gradient text-white">
                    <h5 class="modal-title" id="profileEditModalLabel">Profil Düzenleme</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form method="post" asp-action="UpdateProfile" enctype="multipart/form-data">

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email Adresiniz</label>
                            <input asp-for="Email" class="form-control" readonly />
                        </div>
                        <input asp-for="Id" hidden />
                        <input asp-for="UserTypeId" hidden />
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Kullanıcı Şifreniz</label>
                            <input asp-for="Password" class="form-control" value="@Model.Password" />
                        </div>
                        <div class="mb-3 text-end">
                            <button type="submit" class="btn btn-success">Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const password = '@Model.Password';
    const passwordDisplay = document.getElementById('passwordDisplay');
    const eyeIcon = document.getElementById('eyeIcon');


    passwordDisplay.textContent = '*'.repeat(password.length); 

    document.getElementById('togglePassword').addEventListener('click', function () {
        if (passwordDisplay.textContent === '*'.repeat(password.length)) {
            passwordDisplay.textContent = password;
            eyeIcon.classList.remove('fa-eye');
            eyeIcon.classList.add('fa-eye-slash');
        } else {
            passwordDisplay.textContent = '*'.repeat(password.length);
            eyeIcon.classList.remove('fa-eye-slash');
            eyeIcon.classList.add('fa-eye');
        }
    });
</script>
